# Project A (no billing): https://aistudio.google.com
GEMINI_API_KEY=
# https://console.groq.com
GROQ_API_KEY=
# Project B (billing, budget alert), Cloud Text-to-Speech API enabled. EITHER an API key restricted to that API:
GOOGLE_TTS_API_KEY=
# ...OR a service-account JSON file (used only if no API key is set):
GOOGLE_APPLICATION_CREDENTIALS=google-tts-key.json
# Log actions without executing them
DRY_RUN=false
